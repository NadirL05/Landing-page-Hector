{
  "name": "hector-vitrine",
  "main": "worker/monitoring.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/monitoring",
      "/monitoring/"
    ]
  }
}
